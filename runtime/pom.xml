<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jvnet.com4j</groupId>
    <artifactId>com4j-parent</artifactId>
    <version>2.2-SNAPSHOT</version>
  </parent>

  <artifactId>com4j</artifactId>
  <version>2.2-SNAPSHOT</version>

  <name>com4j</name>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>1.7</version>
        <executions>
          <execution>
            <phase>generate-resources</phase>
            <configuration>
              <target>
                <!--
                  overwrite="true": Ant's default copy behavior is a timestamp check, not a content check.
                  Without it, a target/ directory left over from an earlier build with a different -Dmode
                  (e.g. Debug, whose bin/ output can have a newer timestamp) silently keeps serving that
                  stale DLL here even after bin/ is rebuilt for this mode - with no
                  error or warning that anything is wrong.
                -->
                <copy file="../bin/x86/${mode}/com4j.dll" tofile="target/classes/com4j/com4j-x86.dll" overwrite="true" />
                <copy file="../bin/x64/${mode}/com4j.dll" tofile="target/classes/com4j/com4j-amd64.dll" overwrite="true" />
              </target>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <mode>Release</mode><!-- set to Debug to bundle debug builds of the DLL -->
  </properties>
</project>
